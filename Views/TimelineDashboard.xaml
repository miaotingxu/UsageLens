<UserControl x:Class="CodexQuotaFloat.Views.TimelineDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             Height="195"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
  <Border x:Name="DashboardCard"
          Background="#B312161C"
          BorderBrush="#33485766"
          BorderThickness="3,0,0,0"
          CornerRadius="0,0,6,6"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="10" Opacity="0.42" />
    </Border.Effect>
    <Border.Resources>
      <Style x:Key="TimelineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="#C5CED8" />
      </Style>
      <Style x:Key="TokenValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift, Microsoft YaHei UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
    </Border.Resources>

    <Grid Margin="14,8,12,7">
      <Grid.RowDefinitions>
        <RowDefinition Height="19" />
        <RowDefinition Height="43" />
        <RowDefinition Height="43" />
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock Style="{StaticResource TimelineText}" FontSize="9" FontWeight="SemiBold" Text="CODEX QUOTA" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Ellipse Width="5" Height="5" Margin="0,3,4,0" Fill="#55D6A4">
            <Ellipse.Effect><DropShadowEffect Color="#55D6A4" BlurRadius="7" Opacity="0.8" /></Ellipse.Effect>
          </Ellipse>
          <TextBlock FontFamily="Bahnschrift" FontSize="8" Foreground="#738196" Text="LIVE" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource TimelineText}" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0" Text="5小时" />
        <Grid Grid.Column="1" Margin="0,4,8,0">
          <Grid.RowDefinitions><RowDefinition Height="9" /><RowDefinition Height="17" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Grid.Row="0" Width="178" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border Background="#29D7DEE7" CornerRadius="2" />
            <Border x:Name="FiveHourProgressFill" Width="0" Height="3" HorizontalAlignment="Left" Background="#55D6A4" CornerRadius="2" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="FiveHourResetValue" Grid.Row="1" FontFamily="Cascadia Code, Consolas" FontSize="8" Foreground="#758397" Text="--" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock x:Name="FiveHourValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="Cascadia Code, Consolas" FontSize="12" FontWeight="Bold" Foreground="#D7DEE7" Text="..." />
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource TimelineText}" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0" Text="7天额度" />
        <Grid Grid.Column="1" Margin="0,4,8,0">
          <Grid.RowDefinitions><RowDefinition Height="9" /><RowDefinition Height="17" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Grid.Row="0" Width="178" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border Background="#29D7DEE7" CornerRadius="2" />
            <Border x:Name="WeeklyProgressFill" Width="0" Height="3" HorizontalAlignment="Left" Background="#55D6A4" CornerRadius="2" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="WeeklyResetValue" Grid.Row="1" FontFamily="Cascadia Code, Consolas" FontSize="8" Foreground="#758397" Text="--" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock x:Name="WeeklyValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="Cascadia Code, Consolas" FontSize="12" FontWeight="Bold" Foreground="#D7DEE7" Text="..." />
      </Grid>

      <Grid Grid.Row="3">
        <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="1" /></Grid.RowDefinitions>
        <Border Background="#1FFFFFFF" />
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="6,6">
            <TextBlock HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="8" Foreground="#758397" Text="当日" />
            <TextBlock x:Name="TodayTotalValue" Style="{StaticResource TokenValue}" Margin="0,3,0,0" FontSize="10" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="TodayPriceValue" Style="{StaticResource TokenValue}" Margin="0,1,0,0" FontSize="8" Foreground="#78D6A5" Text="(约...)" />
          </StackPanel>
          <Border Grid.Column="1" Background="#1FFFFFFF" Margin="0,5" />
          <StackPanel Grid.Column="2" Margin="6,6">
            <TextBlock HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="8" Foreground="#758397" Text="近7天" />
            <TextBlock x:Name="SevenDayTotalValue" Style="{StaticResource TokenValue}" Margin="0,3,0,0" FontSize="10" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="SevenDayPriceValue" Style="{StaticResource TokenValue}" Margin="0,1,0,0" FontSize="8" Foreground="#78D6A5" Text="(约...)" />
          </StackPanel>
          <Border Grid.Column="3" Background="#1FFFFFFF" Margin="0,5" />
          <StackPanel Grid.Column="4" Margin="6,6">
            <TextBlock HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="8" Foreground="#758397" Text="近30天" />
            <TextBlock x:Name="ThirtyDayTotalValue" Style="{StaticResource TokenValue}" Margin="0,3,0,0" FontSize="10" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="ThirtyDayPriceValue" Style="{StaticResource TokenValue}" Margin="0,1,0,0" FontSize="8" Foreground="#78D6A5" Text="(约...)" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="#1FFFFFFF" />
      </Grid>

      <Grid Grid.Row="4" Margin="0,3,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusValue" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#8292A7" Text="正在连接 Codex…" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="TokenStatusValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#8292A7" Text="Loading…" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
