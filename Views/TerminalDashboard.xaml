<UserControl x:Class="UsageLens.Views.TerminalDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             Height="195"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
  <Border x:Name="DashboardCard"
          Background="#B30B0F0D"
          BorderBrush="#4A69D08F"
          BorderThickness="1"
          CornerRadius="0,0,2,2"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="7" Opacity="0.5" />
    </Border.Effect>
    <Border.Resources>
      <Style x:Key="TermText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
        <Setter Property="Foreground" Value="#A5B8AA" />
      </Style>
      <Style x:Key="TokenValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Border.Resources>

    <Grid Margin="13,7,13,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="14" />
        <RowDefinition Height="40" />
        <RowDefinition Height="40" />
        <RowDefinition Height="21" />
        <RowDefinition Height="21" />
        <RowDefinition Height="21" />
        <RowDefinition Height="25" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock Style="{StaticResource TermText}" FontSize="7" Foreground="#628B70" Text="USAGE_LENS" />
        <TextBlock HorizontalAlignment="Right" Style="{StaticResource TermText}" FontSize="7" Foreground="#69D08F" Text="ONLINE" />
      </Grid>

      <Grid Grid.Row="1" Margin="0,0,0,1" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="57" />
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource TermText}" FontSize="10" VerticalAlignment="Center" Text="5小时" />
        <TextBlock x:Name="FiveHourValue" Grid.Column="1" Style="{StaticResource TermText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#D7DEE7" Text="..." />
        <Grid Grid.Column="2" VerticalAlignment="Center">
          <Grid.RowDefinitions><RowDefinition Height="17" /><RowDefinition Height="8" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource TermText}" FontSize="7" Foreground="#617067" Text="RESET  " />
            <TextBlock x:Name="FiveHourResetValue" Style="{StaticResource TermText}" FontSize="9" Foreground="#829389" Text="--" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Grid Grid.Row="1" Width="154" Height="2" HorizontalAlignment="Left">
            <Border Background="#2869D08F" />
            <Border x:Name="FiveHourProgressFill" Width="0" Height="2" HorizontalAlignment="Left" Background="#55D6A4" Visibility="Collapsed" />
          </Grid>
        </Grid>
      </Grid>

      <Grid Grid.Row="2" Margin="0,0,0,1" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="57" />
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource TermText}" FontSize="10" VerticalAlignment="Center" Text="7天额度" />
        <TextBlock x:Name="WeeklyValue" Grid.Column="1" Style="{StaticResource TermText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#D7DEE7" Text="..." />
        <Grid Grid.Column="2" VerticalAlignment="Center">
          <Grid.RowDefinitions><RowDefinition Height="17" /><RowDefinition Height="8" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource TermText}" FontSize="7" Foreground="#617067" Text="RESET  " />
            <TextBlock x:Name="WeeklyResetValue" Style="{StaticResource TermText}" FontSize="9" Foreground="#829389" Text="--" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Grid Grid.Row="1" Width="154" Height="2" HorizontalAlignment="Left">
            <Border Background="#2869D08F" />
            <Border x:Name="WeeklyProgressFill" Width="0" Height="2" HorizontalAlignment="Left" Background="#55D6A4" Visibility="Collapsed" />
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" Height="1" Background="#2469D08F" IsHitTestVisible="False" />

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="57" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource TermText}" FontSize="9" Foreground="#69D08F" Text="> " />
          <TextBlock Style="{StaticResource TermText}" FontSize="9" Text="当日" />
        </StackPanel>
        <TextBlock x:Name="TodayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
        <TextBlock x:Name="TodayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
      </Grid>
      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="57" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource TermText}" FontSize="9" Foreground="#69D08F" Text="> " />
          <TextBlock Style="{StaticResource TermText}" FontSize="9" Text="近7天" />
        </StackPanel>
        <TextBlock x:Name="SevenDayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
        <TextBlock x:Name="SevenDayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
      </Grid>
      <Grid Grid.Row="5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="57" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource TermText}" FontSize="9" Foreground="#69D08F" Text="> " />
          <TextBlock Style="{StaticResource TermText}" FontSize="9" Text="近30天" />
        </StackPanel>
        <TextBlock x:Name="ThirtyDayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
        <TextBlock x:Name="ThirtyDayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
      </Grid>

      <Grid Grid.Row="6" Margin="0,3,0,0">
        <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#2469D08F" />
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource TermText}" FontSize="9" Foreground="#52635A" VerticalAlignment="Center" Text="Q " />
          <TextBlock x:Name="StatusValue" Grid.Column="1" Style="{StaticResource TermText}" FontSize="9" Foreground="#6F8076" VerticalAlignment="Center" Text="正在连接 Codex…" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Style="{StaticResource TermText}" FontSize="9" Foreground="#52635A" VerticalAlignment="Center" Text="T " />
          <TextBlock x:Name="TokenStatusValue" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource TermText}" FontSize="9" Foreground="#6F8076" VerticalAlignment="Center" Text="Loading…" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
