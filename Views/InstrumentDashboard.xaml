<UserControl x:Class="CodexQuotaFloat.Views.InstrumentDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             Height="195"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
  <Border Background="#B30B141B"
          BorderBrush="#3D77D3DA"
          BorderThickness="1"
          CornerRadius="0,0,13,13"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="8" Opacity="0.42" />
    </Border.Effect>
    <Border.Resources>
      <Style x:Key="InstrumentLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="#D8E4EC" />
      </Style>
      <Style x:Key="TokenValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Border.Resources>

    <Grid Margin="14,9,14,7">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1" />
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1" Background="#2077D3DA" Margin="0,5" />

        <Grid Grid.Column="0" Margin="0,0,7,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="42" Height="42" VerticalAlignment="Center">
            <Ellipse Width="36" Height="36" Stroke="#25FFFFFF" StrokeThickness="3" />
            <Path x:Name="FiveHourGaugeArc" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <TextBlock x:Name="FiveHourValue" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas" FontSize="10" FontWeight="Bold" Foreground="#D7DEE7" Text="..." />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource InstrumentLabel}" FontSize="11" Text="5小时" />
            <TextBlock x:Name="FiveHourResetValue" Margin="0,4,0,0" FontFamily="Cascadia Code, Consolas" FontSize="8" Foreground="#899CAD" Text="--" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Grid Grid.Column="2" Margin="7,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="42" Height="42" VerticalAlignment="Center">
            <Ellipse Width="36" Height="36" Stroke="#25FFFFFF" StrokeThickness="3" />
            <Path x:Name="WeeklyGaugeArc" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <TextBlock x:Name="WeeklyValue" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas" FontSize="10" FontWeight="Bold" Foreground="#D7DEE7" Text="..." />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource InstrumentLabel}" FontSize="11" Text="7天额度" />
            <TextBlock x:Name="WeeklyResetValue" Margin="0,4,0,0" FontFamily="Cascadia Code, Consolas" FontSize="8" Foreground="#899CAD" Text="--" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Grid>

      <Border Grid.Row="1" Background="#2677D3DA" />

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource InstrumentLabel}" FontSize="10" VerticalAlignment="Center" Text="当日" />
        <TextBlock x:Name="TodayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
        <TextBlock x:Name="TodayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
      </Grid>
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource InstrumentLabel}" FontSize="10" VerticalAlignment="Center" Text="近7天" />
        <TextBlock x:Name="SevenDayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
        <TextBlock x:Name="SevenDayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
      </Grid>
      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource InstrumentLabel}" FontSize="10" VerticalAlignment="Center" Text="近30天" />
        <TextBlock x:Name="ThirtyDayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
        <TextBlock x:Name="ThirtyDayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
      </Grid>

      <Grid Grid.Row="5" Margin="0,4,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="1" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#22FFFFFF">
          <Border.OpacityMask>
            <DrawingBrush TileMode="Tile" Viewport="0,0,5,1" ViewportUnits="Absolute">
              <DrawingBrush.Drawing>
                <GeometryDrawing Brush="White" Geometry="M0,0 L3,0 3,1 0,1Z" />
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Border.OpacityMask>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusValue" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas" FontSize="8" Foreground="#8295A8" Text="正在连接 Codex…" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="TokenStatusValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas" FontSize="8" Foreground="#8295A8" Text="Loading…" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
