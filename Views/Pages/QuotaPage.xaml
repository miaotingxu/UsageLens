<UserControl x:Class="UsageLens.Views.Pages.QuotaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="5 小时额度" Style="{StaticResource CardLabelStyle}" />
            <TextBlock Text="{Binding FiveHourText}" Foreground="{Binding FiveHourBrush}" Style="{StaticResource HugeNumberStyle}" />
            <ProgressBar Margin="0,12,0,10" Height="6" Maximum="100" Value="{Binding Snapshot.Quota.FiveHourRemaining}" Foreground="{Binding FiveHourBrush}" Background="#263649" BorderThickness="0" />
            <TextBlock Text="RESET" Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="{Binding FiveHourResetText}" Style="{StaticResource ResetTextStyle}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Margin="6,0,0,0">
          <StackPanel>
            <TextBlock Text="7 天额度" Style="{StaticResource CardLabelStyle}" />
            <TextBlock Text="{Binding WeeklyText}" Foreground="{Binding WeeklyBrush}" Style="{StaticResource HugeNumberStyle}" />
            <ProgressBar Margin="0,12,0,10" Height="6" Maximum="100" Value="{Binding Snapshot.Quota.WeeklyRemaining}" Foreground="{Binding WeeklyBrush}" Background="#263649" BorderThickness="0" />
            <TextBlock Text="RESET" Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="{Binding WeeklyResetText}" Style="{StaticResource ResetTextStyle}" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource SectionCardStyle}">
        <StackPanel>
          <TextBlock Text="数据说明" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock Margin="0,10,0,0" Text="剩余百分比 = 100 - Codex reported usedPercent；更新频率按设置执行。" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
          <TextBlock Margin="0,10,0,0" Text="颜色：&gt;80% 绿色，50–80% 黄色，20–49% 琥珀色，&lt;20% 红色。" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
