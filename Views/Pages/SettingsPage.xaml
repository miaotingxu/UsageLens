<UserControl x:Class="UsageLens.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UsageLens.Models"
             Loaded="PageOnLoaded"
             Unloaded="PageOnUnloaded"
             UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="SettingsCardStyle" TargetType="Border"><Setter Property="Padding" Value="18"/><Setter Property="Background" Value="#142536"/><Setter Property="BorderBrush" Value="#2A4057"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/></Style>
    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF5FC"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SettingsEnglishStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#71879D"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="8,2,0,0"/></Style>
    <Style x:Key="SettingLabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#CEDAE6"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SettingHintStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#71879D"/><Setter Property="FontSize" Value="9"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="SettingDividerStyle" TargetType="Border"><Setter Property="BorderBrush" Value="#23384C"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="0,0,0,11"/><Setter Property="Margin" Value="0,11,0,0"/></Style>
    <Style x:Key="StyleChipStyle" TargetType="RadioButton">
      <Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Foreground" Value="#8498AC"/><Setter Property="Background" Value="#192B3D"/><Setter Property="BorderBrush" Value="#2A4057"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="8,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#1B4642"/><Setter TargetName="Chip" Property="BorderBrush" Value="#4FCAA0"/><Setter Property="Foreground" Value="#A5F0D1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#56728B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="22"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="40" Height="22"><Border x:Name="Track" Background="#34485E" BorderBrush="#466078" BorderThickness="1" CornerRadius="11"/><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#D8E5EF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#257B65"/><Setter TargetName="Track" Property="BorderBrush" Value="#4FC9A0"/><Setter TargetName="Thumb" Property="Fill" Value="#E6FFF4"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#87EBC7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Height" Value="31"/><Setter Property="Padding" Value="10,0"/><Setter Property="Foreground" Value="#F2F7FC"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="3,1"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#28435A"/><Setter Property="Foreground" Value="#E5F5FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1D5048"/><Setter Property="Foreground" Value="#9AF0D1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsComboToggleStyle" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Width" Value="104"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0,8,0"/><Setter Property="Foreground" Value="#F2F7FC"/><Setter Property="Background" Value="#1A2D40"/><Setter Property="BorderBrush" Value="#314A63"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid SnapsToDevicePixels="True"><ToggleButton x:Name="ToggleButton" Style="{StaticResource SettingsComboToggleStyle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><Border x:Name="SelectBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/><Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#91A7BA" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/></Grid></Border></ToggleButton><Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Padding="3" Background="#13283B" BorderBrush="#3A5870" BorderThickness="1" CornerRadius="9"><ScrollViewer CanContentScroll="True" MaxHeight="180" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectBorder" Property="BorderBrush" Value="#587A94"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectBorder" Property="BorderBrush" Value="#65DDB3"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="SelectBorder" Property="Background" Value="#20384C"/><Setter TargetName="SelectBorder" Property="BorderBrush" Value="#65DDB3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsSliderStyle" TargetType="Slider"><Setter Property="Height" Value="24"/><Setter Property="Foreground" Value="#69E0B4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24"><Track x:Name="PART_Track" VerticalAlignment="Center" Height="5"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="#69E0B4" BorderThickness="0" Height="5"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="18" Height="18" Background="#69E0B4" BorderBrush="#A8F8DC" BorderThickness="1"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="#405365" BorderThickness="0" Height="5"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SettingsGhostButtonStyle" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="Foreground" Value="#B7C9D8"/><Setter Property="Background" Value="#1A2D40"/><Setter Property="BorderBrush" Value="#314A63"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#263D53"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#587891"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#122334"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsGhostButtonStyle}"><Setter Property="Foreground" Value="#B6F5DB"/><Setter Property="Background" Value="#1B4942"/><Setter Property="BorderBrush" Value="#3DAB88"/></Style>
    <Style x:Key="SettingsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsGhostButtonStyle}"><Setter Property="Foreground" Value="#F1C49D"/><Setter Property="Background" Value="#3A2A25"/><Setter Property="BorderBrush" Value="#89604A"/></Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,2,12">
      <Border Background="#102B34" BorderBrush="#245467" BorderThickness="1" CornerRadius="14" Padding="14,11" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="#183D4C" BorderBrush="#37738C" BorderThickness="1" CornerRadius="9" VerticalAlignment="Center"><TextBlock Text="C" Foreground="#8FDAC4" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Codex 连接状态" Foreground="#DDF1FA" FontSize="11" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="#71879D"/><TextBlock Text="{Binding CodexStatusText}" Foreground="#79E5B7" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Text="复用本机 Codex 登录态；UsageLens 不读取或保存凭据。" Style="{StaticResource SettingHintStyle}"/></StackPanel><Border Grid.Column="2" Background="#173B35" CornerRadius="10" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="本机数据 · 已保护" Foreground="#79E5B7" FontSize="9" FontWeight="SemiBold"/></Border></Grid></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}" Margin="0,0,7,12"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="外观" Style="{StaticResource SettingsTitleStyle}"/><TextBlock Text="Appearance" Style="{StaticResource SettingsEnglishStyle}"/></StackPanel><TextBlock Text="界面样式" Style="{StaticResource SettingLabelStyle}" Margin="0,15,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="InstrumentStyleButton" Grid.Column="0" Content="Instrument" Tag="Instrument" GroupName="FloatingStyle" Click="StyleButtonOnClick" Style="{StaticResource StyleChipStyle}" AutomationProperties.Name="切换到仪表样式"/><RadioButton x:Name="GlassStyleButton" Grid.Column="1" Content="Glass" Tag="Glass" GroupName="FloatingStyle" Click="StyleButtonOnClick" Style="{StaticResource StyleChipStyle}" AutomationProperties.Name="切换到玻璃样式"/><RadioButton x:Name="TimelineStyleButton" Grid.Column="2" Content="Timeline" Tag="Timeline" GroupName="FloatingStyle" Click="StyleButtonOnClick" Style="{StaticResource StyleChipStyle}" AutomationProperties.Name="切换到时间线样式"/><RadioButton x:Name="TerminalStyleButton" Grid.Column="3" Content="Terminal" Tag="Terminal" GroupName="FloatingStyle" Click="StyleButtonOnClick" Style="{StaticResource StyleChipStyle}" Margin="0" AutomationProperties.Name="切换到终端样式"/></Grid><Border Style="{StaticResource SettingDividerStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="174"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="窗口透明度" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="保持悬浮信息清晰易读" Style="{StaticResource SettingHintStyle}"/></StackPanel><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Slider Style="{StaticResource SettingsSliderStyle}" Minimum="0.35" Maximum="1" Value="{Binding FloatingOpacity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="窗口透明度"/><TextBlock Grid.Column="1" Text="{Binding FloatingOpacity, StringFormat={}{0:P0}}" Foreground="#79E5B7" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid></Border><Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="窗口位置" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="恢复到主屏幕顶部居中" Style="{StaticResource SettingHintStyle}"/></StackPanel><Button Grid.Column="1" Content="恢复默认" Style="{StaticResource SettingsGhostButtonStyle}" Command="{Binding ResetPositionCommand}" AutomationProperties.Name="重置顶部横向位置"/></Grid></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Margin="7,0,0,12"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="悬浮行为" Style="{StaticResource SettingsTitleStyle}"/><TextBlock Text="Floating" Style="{StaticResource SettingsEnglishStyle}"/></StackPanel><Border Style="{StaticResource SettingDividerStyle}" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="自动折叠" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="离开窗口后自动收起" Style="{StaticResource SettingHintStyle}"/></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding AutoCollapseEnabled}" AutomationProperties.Name="自动折叠"/></Grid></Border><Border Style="{StaticResource SettingDividerStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="折叠延迟" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="鼠标离开后的等待时间" Style="{StaticResource SettingHintStyle}"/></StackPanel><ComboBox Grid.Column="1" Style="{StaticResource SettingsComboBoxStyle}" SelectedValue="{Binding CollapseDelaySeconds}" SelectedValuePath="Tag" AutomationProperties.Name="折叠延迟"><ComboBoxItem Content="1 秒" Tag="1"/><ComboBoxItem Content="2 秒" Tag="2"/><ComboBoxItem Content="3 秒" Tag="3"/></ComboBox></Grid></Border><Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="悬停把手展开" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="移动到顶部把手即可展开" Style="{StaticResource SettingHintStyle}"/></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding ExpandOnHandleHover}" AutomationProperties.Name="悬停把手展开"/></Grid></StackPanel></Border>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}" Margin="0,0,7,12"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="数据刷新" Style="{StaticResource SettingsTitleStyle}"/><TextBlock Text="Refresh" Style="{StaticResource SettingsEnglishStyle}"/></StackPanel><Border Style="{StaticResource SettingDividerStyle}" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="额度刷新" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="读取本机 Codex 额度" Style="{StaticResource SettingHintStyle}"/></StackPanel><ComboBox Grid.Column="1" Style="{StaticResource SettingsComboBoxStyle}" SelectedValue="{Binding QuotaRefreshMinutes}" SelectedValuePath="Tag" AutomationProperties.Name="额度刷新"><ComboBoxItem Content="1 分钟" Tag="1"/><ComboBoxItem Content="3 分钟" Tag="3"/><ComboBoxItem Content="5 分钟" Tag="5"/></ComboBox></Grid></Border><Border Style="{StaticResource SettingDividerStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Token 统计刷新" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="扫描本地会话元数据" Style="{StaticResource SettingHintStyle}"/></StackPanel><ComboBox Grid.Column="1" Style="{StaticResource SettingsComboBoxStyle}" SelectedValue="{Binding TokenRefreshMinutes}" SelectedValuePath="Tag" AutomationProperties.Name="Token 刷新"><ComboBoxItem Content="5 分钟" Tag="5"/><ComboBoxItem Content="10 分钟" Tag="10"/><ComboBoxItem Content="15 分钟" Tag="15"/></ComboBox></Grid></Border><Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="立即刷新" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="同时更新额度和 Token" Style="{StaticResource SettingHintStyle}"/></StackPanel><Button Grid.Column="1" Content="立即刷新" Style="{StaticResource SettingsPrimaryButtonStyle}" Command="{Binding RefreshNowCommand}" AutomationProperties.Name="立即刷新额度和 Token"/></Grid></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Margin="7,0,0,12"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="托盘与启动" Style="{StaticResource SettingsTitleStyle}"/><TextBlock Text="Tray" Style="{StaticResource SettingsEnglishStyle}"/></StackPanel><Border Style="{StaticResource SettingDividerStyle}" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开机自动启动" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="默认关闭，避免影响启动速度" Style="{StaticResource SettingHintStyle}"/></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="开机自动启动"/></Grid></Border><Border Style="{StaticResource SettingDividerStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="关闭时隐藏到托盘" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="从托盘菜单可完全退出" Style="{StaticResource SettingHintStyle}"/></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding HideControlCenterOnClose}" AutomationProperties.Name="关闭中心时隐藏到托盘"/></Grid></Border><Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="托盘单击行为" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="控制中心或显示悬浮窗" Style="{StaticResource SettingHintStyle}"/></StackPanel><ComboBox Grid.Column="1" Width="128" Style="{StaticResource SettingsComboBoxStyle}" SelectedValue="{Binding TrayPrimaryAction}" SelectedValuePath="Tag" AutomationProperties.Name="托盘单击动作"><ComboBoxItem Content="打开控制中心" Tag="{x:Static models:TrayPrimaryAction.OpenControlCenter}"/><ComboBoxItem Content="显示悬浮窗" Tag="{x:Static models:TrayPrimaryAction.ToggleFloatingWindow}"/></ComboBox></Grid></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="隐私与诊断" Style="{StaticResource SettingsTitleStyle}"/><TextBlock Text="Privacy &amp; Diagnostics" Style="{StaticResource SettingsEnglishStyle}"/></StackPanel><TextBlock Text="只读取本机 Codex 额度和会话元数据；不会上传聊天正文、密码或 API Key。" Foreground="#9FB1C3" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#192B3D" CornerRadius="9" Padding="10,8" Margin="0,0,6,0"><StackPanel><TextBlock Text="CODEX" Style="{StaticResource SettingHintStyle}" Margin="0"/><TextBlock Text="{Binding CodexStatusText}" Foreground="#79E5B7" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#192B3D" CornerRadius="9" Padding="10,8" Margin="0,0,6,0"><StackPanel><TextBlock Text="QUOTA" Style="{StaticResource SettingHintStyle}" Margin="0"/><TextBlock Text="{Binding QuotaStatusText}" Foreground="#C6D6E5" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#192B3D" CornerRadius="9" Padding="10,8" Margin="0,0,6,0"><StackPanel><TextBlock Text="TOKEN" Style="{StaticResource SettingHintStyle}" Margin="0"/><TextBlock Text="{Binding TokenStatusText}" Foreground="#C6D6E5" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="3" Background="#192B3D" CornerRadius="9" Padding="10,8"><StackPanel><TextBlock Text="LAST UPDATE" Style="{StaticResource SettingHintStyle}" Margin="0"/><TextBlock Text="{Binding LastUpdateText}" Foreground="#C6D6E5" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></Grid><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="复制脱敏诊断" Style="{StaticResource SettingsGhostButtonStyle}" Command="{Binding CopyDiagnosticsCommand}" AutomationProperties.Name="复制脱敏诊断"/><Button Grid.Column="1" Content="重置界面偏好" Style="{StaticResource SettingsDangerButtonStyle}" Command="{Binding ResetUiPreferencesCommand}" AutomationProperties.Name="重置界面偏好" Margin="8,0,0,0"/><TextBlock Grid.Column="2" Text="{Binding FeedbackText}" Foreground="#79E5B7" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"/></Grid></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
