<UserControl x:Class="UsageLens.Views.Pages.SessionSourcePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="统计范围" Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Margin="0,12,0,0" Text="数据源：本机 .codex\\sessions" Style="{StaticResource BodyTextStyle}" />
        <TextBlock Margin="0,6,0,0" Text="统计窗口：近 30 个本地自然日" Style="{StaticResource BodyTextStyle}" />
        <TextBlock Margin="0,6,0,0" Text="读取内容：token_count 用量元数据" Style="{StaticResource BodyTextStyle}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="隐私边界" Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Margin="0,12,0,0" Text="不会上传会话文件，不会读取对话正文，不会保存账号凭据。" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource SectionCardStyle}">
      <StackPanel>
        <DockPanel><TextBlock Text="扫描状态" Style="{StaticResource SectionTitleStyle}" /><TextBlock DockPanel.Dock="Right" Text="{Binding SessionStatusText}" Style="{StaticResource MutedTextStyle}" /></DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="上次扫描：" Style="{StaticResource BodyTextStyle}" /><TextBlock Text="{Binding LastScanText}" Style="{StaticResource BodyTextStyle}" /></StackPanel>
        <TextBlock Margin="0,6,0,0" Text="仅保留聚合结果，不展示文件名、会话标题或原始 JSON。" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
