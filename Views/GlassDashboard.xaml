<UserControl x:Class="UsageLens.Views.GlassDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             Height="195"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
  <Border x:Name="DashboardCard"
          BorderBrush="#3DFFFFFF"
          BorderThickness="1"
          CornerRadius="0,0,16,16"
          SnapsToDevicePixels="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B3263040" Offset="0" />
        <GradientStop Color="#B3121821" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="9" Opacity="0.48" />
    </Border.Effect>
    <Border.Resources>
      <Style x:Key="QuotaTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#C6D0DC" />
      </Style>
      <Style x:Key="TokenValue" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Bahnschrift, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </Border.Resources>

    <Grid Margin="12,10,12,7">
      <Grid.RowDefinitions>
        <RowDefinition Height="70" />
        <RowDefinition Height="8" />
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="9,8,9,7" CornerRadius="10" BorderBrush="#24FFFFFF" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#16FFFFFF" Offset="0" />
              <GradientStop Color="#06FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="22" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <TextBlock Style="{StaticResource QuotaTitle}" Text="5小时" />
              <TextBlock x:Name="FiveHourValue" HorizontalAlignment="Right" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="#D7DEE7" Text="..." />
            </Grid>
            <TextBlock x:Name="FiveHourResetValue" Grid.Row="1" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas" FontSize="9" Foreground="#8795A7" Text="--" TextTrimming="CharacterEllipsis" />
            <Grid Grid.Row="2" Width="112" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom">
              <Border Background="#2ED7DEE7" CornerRadius="1" />
              <Border x:Name="FiveHourProgressFill" Width="0" Height="2" HorizontalAlignment="Left" Background="#55D6A4" CornerRadius="1" Visibility="Collapsed" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="2" Padding="9,8,9,7" CornerRadius="10" BorderBrush="#24FFFFFF" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#16FFFFFF" Offset="0" />
              <GradientStop Color="#06FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="22" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <TextBlock Style="{StaticResource QuotaTitle}" Text="7天额度" />
              <TextBlock x:Name="WeeklyValue" HorizontalAlignment="Right" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="#D7DEE7" Text="..." />
            </Grid>
            <TextBlock x:Name="WeeklyResetValue" Grid.Row="1" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas" FontSize="9" Foreground="#8795A7" Text="--" TextTrimming="CharacterEllipsis" />
            <Grid Grid.Row="2" Width="112" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom">
              <Border Background="#2ED7DEE7" CornerRadius="1" />
              <Border x:Name="WeeklyProgressFill" Width="0" Height="2" HorizontalAlignment="Left" Background="#55D6A4" CornerRadius="1" Visibility="Collapsed" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Padding="9,2" CornerRadius="10" Background="#4D070B10" BorderBrush="#16FFFFFF" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="1" />
            <RowDefinition Height="24" />
            <RowDefinition Height="1" />
            <RowDefinition Height="24" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="10" Foreground="#A4AFBD" Text="当日" />
            <TextBlock x:Name="TodayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="TodayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
          </Grid>
          <Border Grid.Row="1" Background="#16FFFFFF" />
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="10" Foreground="#A4AFBD" Text="近7天" />
            <TextBlock x:Name="SevenDayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="SevenDayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
          </Grid>
          <Border Grid.Row="3" Background="#16FFFFFF" />
          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="10" Foreground="#A4AFBD" Text="近30天" />
            <TextBlock x:Name="ThirtyDayTotalValue" Grid.Column="1" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="ThirtyDayPriceValue" Grid.Column="2" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="2,4,2,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusValue" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#8292A7" Text="正在连接 Codex…" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="TokenStatusValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#8292A7" Text="Loading…" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
