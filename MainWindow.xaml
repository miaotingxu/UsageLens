<Window x:Class="CodexQuotaFloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="205"
        Title="Codex 额度悬浮窗"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="刷新" Click="RefreshMenuItemOnClick" />
      <Separator />
      <MenuItem Header="退出" Click="ExitMenuItemOnClick" />
    </ContextMenu>
  </Window.ContextMenu>

  <Grid>
    <Border x:Name="Card"
            Height="195"
            VerticalAlignment="Top"
            Background="#B3171B23"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="0,0,10,10"
            SnapsToDevicePixels="True">
      <Border.Resources>
        <Style x:Key="TokenPeriodLabel" TargetType="TextBlock">
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="Foreground" Value="#D9FFFFFF" />
        </Style>
        <Style x:Key="TokenValue" TargetType="TextBlock">
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
          <Setter Property="FontSize" Value="11" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </Border.Resources>

      <Grid Margin="18,5,18,5">
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="46" />
          <RowDefinition Height="1" />
          <RowDefinition Height="27" />
          <RowDefinition Height="27" />
          <RowDefinition Height="27" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="6" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#D9FFFFFF" Text="5小时" />
            <TextBlock x:Name="FiveHourResetValue" Margin="0,1,0,0" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#B8C5D4" Text="--" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock x:Name="FiveHourValue" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="14" FontWeight="SemiBold" Foreground="#D7DEE7" Text="..." />
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Width="200" Height="2" HorizontalAlignment="Left">
            <Border Background="#33D7DEE7" CornerRadius="1" />
            <Border x:Name="FiveHourProgressFill" Width="0" Height="2" HorizontalAlignment="Left" Background="#55D6A4" CornerRadius="1" Visibility="Collapsed" />
          </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="6" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#D9FFFFFF" Text="7天额度" />
            <TextBlock x:Name="WeeklyResetValue" Margin="0,1,0,0" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#B8C5D4" Text="--" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock x:Name="WeeklyValue" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="14" FontWeight="SemiBold" Foreground="#D7DEE7" Text="..." />
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Width="200" Height="2" HorizontalAlignment="Left">
            <Border Background="#33D7DEE7" CornerRadius="1" />
            <Border x:Name="WeeklyProgressFill" Width="0" Height="2" HorizontalAlignment="Left" Background="#55D6A4" CornerRadius="1" Visibility="Collapsed" />
          </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,1,0,0" Background="#26FFFFFF" />

        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource TokenPeriodLabel}" Text="当日" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TodayTotalValue" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="TodayPriceValue" Margin="5,0,0,0" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource TokenPeriodLabel}" Text="近7天" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="SevenDayTotalValue" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="SevenDayPriceValue" Margin="5,0,0,0" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource TokenPeriodLabel}" Text="近30天" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ThirtyDayTotalValue" Style="{StaticResource TokenValue}" Foreground="#79C8FF" Text="..." />
            <TextBlock x:Name="ThirtyDayPriceValue" Margin="5,0,0,0" Style="{StaticResource TokenValue}" Foreground="#78D6A5" Text="(约...)" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="6" Margin="0,2,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusValue" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="10" Foreground="#B8D5E8" Text="正在连接 Codex…" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="TokenStatusValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="10" Foreground="#B8D5E8" Text="Loading…" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="HoverZone"
            Width="80"
            Height="8"
            Margin="0,195,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#B35E697A"
            CornerRadius="0,0,4,4" />
  </Grid>
</Window>
