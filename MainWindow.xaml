<Window x:Class="CodexQuotaFloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="205"
        Title="Codex 额度悬浮窗"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="刷新" Click="RefreshMenuItemOnClick" />
      <Separator />
      <MenuItem Header="退出" Click="ExitMenuItemOnClick" />
    </ContextMenu>
  </Window.ContextMenu>

  <Window.Resources>
    <Style x:Key="StyleOption" TargetType="Button">
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#C9D3DF" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#20FFFFFF" />
          <Setter Property="Foreground" Value="#F3F7FC" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="Card"
            Height="195"
            VerticalAlignment="Top"
            Background="Transparent"
            SnapsToDevicePixels="True">
      <Grid>
        <ContentControl x:Name="StyleContent" />
      </Grid>
    </Border>

    <!-- 独立于四套内容置顶，避免切换入口压住右上角数据。 -->
    <Button x:Name="StylePickerButton"
            Panel.ZIndex="100"
            Width="24"
            Height="18"
            Margin="0,5,6,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Padding="0"
            Background="#E00B1018"
            BorderBrush="#45FFFFFF"
            BorderThickness="1"
            Foreground="#D9E3EF"
            FontFamily="Bahnschrift, Microsoft YaHei UI"
            FontSize="8"
            Cursor="Hand"
            ToolTip="切换界面样式"
            Click="StylePickerButtonOnClick">
      <Grid>
        <TextBlock x:Name="StyleLabelText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />
        <TextBlock x:Name="StyleChevronText"
                   Margin="0,0,2,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="7"
                   Text="▾" />
      </Grid>
    </Button>

    <Border x:Name="HoverZone"
            Width="80"
            Height="8"
            Margin="0,195,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#B35E697A"
            CornerRadius="0,0,4,4" />

    <Popup x:Name="StyleMenuPopup"
           AllowsTransparency="True"
           HorizontalOffset="-102"
           Placement="Bottom"
           PlacementTarget="{Binding ElementName=StylePickerButton}"
           PopupAnimation="Fade"
           StaysOpen="False"
           VerticalOffset="4"
           Closed="StyleMenuPopupOnClosed">
      <Border Width="124"
              Padding="4"
              Background="#F018212E"
              BorderBrush="#2AFFFFFF"
              BorderThickness="1"
              CornerRadius="9"
              SnapsToDevicePixels="True">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
          <TextBlock Margin="7,3,0,3"
                     FontFamily="Microsoft YaHei UI"
                     FontSize="7"
                     Foreground="#718096"
                     Text="界面样式" />
          <Button Tag="Instrument" Click="StyleOptionOnClick" Style="{StaticResource StyleOption}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
              <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="#77D3DA" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="精密仪表" />
              <TextBlock x:Name="InstrumentCheck" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#65E1BA" Text="✓" />
            </Grid>
          </Button>
          <Button Tag="Glass" Click="StyleOptionOnClick" Style="{StaticResource StyleOption}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
              <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="#A9B8FF" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="双层玻璃" />
              <TextBlock x:Name="GlassCheck" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#65E1BA" Text="✓" />
            </Grid>
          </Button>
          <Button Tag="Timeline" Click="StyleOptionOnClick" Style="{StaticResource StyleOption}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
              <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="#668CA9" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="横向时间轴" />
              <TextBlock x:Name="TimelineCheck" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#65E1BA" Text="✓" />
            </Grid>
          </Button>
          <Button Tag="Terminal" Click="StyleOptionOnClick" Style="{StaticResource StyleOption}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
              <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="#69D08F" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="极简终端" />
              <TextBlock x:Name="TerminalCheck" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#65E1BA" Text="✓" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
