<Window x:Class="CodexQuotaFloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="352"
        Height="205"
        Title="Codex 额度悬浮窗"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="刷新" Click="RefreshMenuItemOnClick" />
      <Separator />
      <MenuItem Header="退出" Click="ExitMenuItemOnClick" />
    </ContextMenu>
  </Window.ContextMenu>

  <Window.Resources>
    <Style x:Key="StyleArrowButton" TargetType="Button">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#CC111A26" />
      <Setter Property="BorderBrush" Value="#45FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#D9E3EF" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ArrowBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ArrowBorder" Property="Background" Value="#F01D2B3B" />
                <Setter TargetName="ArrowBorder" Property="BorderBrush" Value="#8AFFFFFF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ArrowBorder" Property="Background" Value="#F02B3B50" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ArrowBorder" Property="Opacity" Value="0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="Card"
            Width="300"
            Height="195"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="Transparent"
            SnapsToDevicePixels="True">
      <Grid>
        <ContentControl x:Name="StyleContent" />
      </Grid>
    </Border>

    <!-- 箭头位于卡片两侧的透明留白区，和卡片边缘保留间距，避免遮挡内容。 -->
    <Grid x:Name="StyleNavigation"
          Panel.ZIndex="100"
          Height="30"
          VerticalAlignment="Center"
          IsHitTestVisible="True"
          MouseEnter="StyleNavigationOnMouseEnter"
          MouseLeave="StyleNavigationOnMouseLeave">
      <Button x:Name="PreviousStyleButton"
              HorizontalAlignment="Left"
              Style="{StaticResource StyleArrowButton}"
              Content="‹"
              ToolTip="上一套界面样式"
              Click="PreviousStyleButtonOnClick" />
      <Button x:Name="NextStyleButton"
              HorizontalAlignment="Right"
              Style="{StaticResource StyleArrowButton}"
              Content="›"
              ToolTip="下一套界面样式"
              Click="NextStyleButtonOnClick" />
    </Grid>

    <Border x:Name="HoverZone"
            Width="80"
            Height="8"
            Margin="0,195,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#B35E697A"
            CornerRadius="0,0,4,4" />
  </Grid>
</Window>
